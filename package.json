{
  "name": "cli-api-learning-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Laboratorio interattivo per imparare CLI (Bash/PowerShell), HTTP/API e documentazione tecnica, con ambienti simulati.",
  "license": "MIT",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "build": "npm run typecheck && npm run build:web",
    "start": "tsx src/server/main.ts",
    "dev": "npm run build:web && tsx watch src/server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "docs:commands": "tsx scripts/gen-commands-doc.ts",
    "course:init": "tsx scripts/course-tools.ts init",
    "course:render": "tsx scripts/course-tools.ts render",
    "course:import": "tsx scripts/course-tools.ts import",
    "course:export": "tsx scripts/course-tools.ts export",
    "course:programma": "tsx scripts/course-tools.ts programma",
    "docs": "npm run docs:commands && npm run course:programma",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
